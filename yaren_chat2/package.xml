<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yaren_chat2</name>
  <version>1.0.0</version>
  <description>
    LLM Local Lifecycle Node for YAREN Chat v2
  </description>
  <maintainer email="yaren@robotis.com">YAREN Team</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>yaren_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_action</depend>
  <depend>lifecycle_msgs</depend>
  
  <exec_depend>python3-llama-cpp-python</exec_depend>
  <exec_depend>python3-torch</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>