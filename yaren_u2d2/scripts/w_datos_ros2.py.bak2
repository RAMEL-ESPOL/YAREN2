#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState
from dynamixel_sdk import *
from motor_classes import XCseries_motor, MX_motor
import threading
import tkinter as tk
from tkinter import ttk, scrolledtext, filedialog, messagebox
import ast
import time
import math

# ---------------------------------------------------------------------------
# Constantes de conversión Dynamixel (MX / XC en modo posición)
# 4096 ticks por vuelta, centro en 2048  ->  1 tick = 360/4096 ≈ 0.088°
# ---------------------------------------------------------------------------
DXL_CENTER = 2048
DXL_MAX_RAW = 4095
TICKS_PER_REV = 4096
RAD_PER_TICK = (2.0 * math.pi) / TICKS_PER_REV
TICKS_PER_RAD = TICKS_PER_REV / (2.0 * math.pi)

ADDR_GOAL_POSITION = 116
ADDR_PRESENT_POSITION = 132
REC_IDS = range(5, 13)   # J5..J12 se graban; J1-J4 quedan fijos


def raw_to_rad(raw: int) -> float:
    return (raw - DXL_CENTER) * RAD_PER_TICK


def rad_to_raw(rad: float) -> int:
    raw = int(round(rad * TICKS_PER_RAD)) + DXL_CENTER
    return max(0, min(DXL_MAX_RAW, raw))


class MotorTorqueControlNode(Node):
    def __init__(self):
        super().__init__('yaren_motor_data')

        self.declare_parameter('usb_port', '/dev/ttyUSB0')
        self.declare_parameter('dxl_baud_rate', 1000000)

        usb_port = self.get_parameter('usb_port').get_parameter_value().string_value
        dxl_baud_rate = self.get_parameter('dxl_baud_rate').get_parameter_value().integer_value

        self.portHandler = PortHandler(usb_port)
        self.packetHandler = PacketHandler(2.0)
        self.num_joints = 12
        self.general_joint_position = [0.0] * self.num_joints
        self.execution_running = False

        self.port_lock = threading.Lock()

        self.recording = False
        self.record_interval = 10.0
        self._rec_samples = []
        self._rec_stop_event = threading.Event()
        self._rec_thread = None
        self._rec_fixed = [0.0] * self.num_joints

        if self.portHandler.openPort():
            self.get_logger().info(f"Puerto {usb_port} abierto con éxito.")
        else:
            self.get_logger().error("Error al abrir el puerto.")

        self.init_motors(usb_port, dxl_baud_rate)
        self.joint_state_pub = self.create_publisher(JointState, '/joint_states', 10)

    def init_motors(self, usb_port, dxl_baud_rate):
        # Joint 1 y 2: MX Series
        self.trunk = MX_motor(usb_port, dxl_baud_rate, [1], self.portHandler, self.packetHandler, None, 20, {1: ['-5', 5]}, {1: [100, 0, 0]})
        self.hip = MX_motor(usb_port, dxl_baud_rate, [2], self.portHandler, self.packetHandler, None, 20, {2: ['-5', 5]}, {2: [100, 0, 0]})

        # Joint 3 al 12: XC Series
        self.neck = XCseries_motor(usb_port, dxl_baud_rate, [3, 4], self.portHandler, self.packetHandler, None, 20, {3: ['-5', 5], 4: ['-5', 5]}, {3: [100, 0, 0], 4: [100, 0, 0]})
        self.sh_r = XCseries_motor(usb_port, dxl_baud_rate, [5], self.portHandler, self.packetHandler, None, 20, {5: ['-5', 5]}, {5: [100, 0, 0]})
        self.fa_r = XCseries_motor(usb_port, dxl_baud_rate, [6, 7], self.portHandler, self.packetHandler, None, 20, {6: ['-5', 5], 7: ['-5', 5]}, {6: [100, 0, 0], 7: [100, 0, 0]})
        self.el_r = XCseries_motor(usb_port, dxl_baud_rate, [8], self.portHandler, self.packetHandler, None, 20, {8: ['-5', 5]}, {8: [100, 0, 0]})
        self.sh_l = XCseries_motor(usb_port, dxl_baud_rate, [9], self.portHandler, self.packetHandler, None, 20, {9: ['-5', 5]}, {9: [100, 0, 0]})
        self.fa_l = XCseries_motor(usb_port, dxl_baud_rate, [10, 11], self.portHandler, self.packetHandler, None, 20, {10: ['-5', 5], 11: ['-5', 5]}, {10: [100, 0, 0], 11: [100, 0, 0]})
        self.el_l = XCseries_motor(usb_port, dxl_baud_rate, [12], self.portHandler, self.packetHandler, None, 20, {12: ['-5', 5]}, {12: [100, 0, 0]})

        self.list_motors = [self.trunk, self.hip, self.neck, self.sh_r, self.fa_r,
                            self.el_r, self.sh_l, self.fa_l, self.el_l]

        names = ["Trunk (J1)", "Hip (J2)", "Neck (J3-4)", "Sh_R (J5)", "Forearm_R (J6-7)",
                 "Elbow_R (J8)", "Sh_L (J9)", "Forearm_L (J10-11)", "Elbow_L (J12)"]
        for motor, name in zip(self.list_motors, names):
            motor.name = name
            motor.torque_state = False

    # ------------------------------------------------------------------
    def get_positions(self, ids=None):
        """Lee posiciones (raw -> rad). ids=None -> todos; si no, solo esos IDs."""
        with self.port_lock:
            for motor in self.list_motors:
                for dxl_id in motor.list_ids:
                    if ids is not None and dxl_id not in ids:
                        continue
                    dxl_pos, res, err = self.packetHandler.read4ByteTxRx(
                        self.portHandler, dxl_id, ADDR_PRESENT_POSITION)
                    if res == COMM_SUCCESS:
                        self.general_joint_position[dxl_id - 1] = round(raw_to_rad(dxl_pos), 4)
        return list(self.general_joint_position)

    def set_positions(self, positions_list):
        """Escribe posiciones (rad -> raw); el valor del ID X está en positions_list[X-1]."""
        try:
            if len(positions_list) < self.num_joints:
                self.get_logger().error(f"Se requieren {self.num_joints} valores.")
                return

            with self.port_lock:
                for motor in self.list_motors:
                    for dxl_id in motor.list_ids:
                        rad = float(positions_list[dxl_id - 1])
                        self.packetHandler.write4ByteTxRx(
                            self.portHandler, dxl_id, ADDR_GOAL_POSITION, rad_to_raw(rad))

            self.get_logger().info("Comando enviado.")

        except Exception as e:
            self.get_logger().error(f"Error en set_positions: {e}")

    # ------------------------------------------------------------------
    # Grabación de rutinas
    # ------------------------------------------------------------------
    def _rec_sample(self):
        """Pose con J1-J4 congelados y J5-J12 leídos en vivo."""
        pos = self.get_positions(ids=REC_IDS)
        pos[:4] = self._rec_fixed[:4]
        return pos

    def start_recording(self, interval=10.0):
        if self.recording:
            return
        self.record_interval = max(0.5, float(interval))
        self._rec_fixed = self.get_positions()      # foto de J1-J4
        self._rec_samples = []
        self._rec_stop_event.clear()
        self.recording = True
        self._rec_thread = threading.Thread(target=self._record_loop, daemon=True)
        self._rec_thread.start()
        self.get_logger().info(f"Grabación iniciada (cada {self.record_interval} s).")

    def _record_loop(self):
        while True:
            self._rec_samples.append((time.time(), self._rec_sample()))
            if self._rec_stop_event.wait(self.record_interval):
                break

    def stop_recording(self):
        """Detiene la grabación y devuelve las líneas en formato de secuencia."""
        if not self.recording:
            return []
        self._rec_stop_event.set()
        if self._rec_thread:
            self._rec_thread.join(timeout=2.0)
        self._rec_samples.append((time.time(), self._rec_sample()))
        self.recording = False

        lines = []
        samples = self._rec_samples
        for i, (ts, pos) in enumerate(samples):
            t = round(samples[i + 1][0] - ts, 1) if i < len(samples) - 1 else 1.0
            lines.append(f"({pos}, {t})")
        self.get_logger().info(f"Grabación detenida: {len(lines)} poses.")
        return lines


# ---------------------------------------------------------------------------
# GUI (optimizada para pantalla 800x480 táctil)
# ---------------------------------------------------------------------------
BG = "#F3F4F6"
CARD = "#FFFFFF"
TEXT = "#111827"
MUTED = "#6B7280"
ACCENT = "#2563EB"
ACCENT_H = "#1D4ED8"
GREEN = "#16A34A"
GREEN_H = "#15803D"
OFF = "#E5E7EB"
OFF_H = "#D1D5DB"
RED = "#DC2626"
RED_H = "#B91C1C"

FONT = "DejaVu Sans"
MONO = "DejaVu Sans Mono"


def setup_style(root):
    s = ttk.Style(root)
    s.theme_use("clam")

    s.configure(".", background=BG, foreground=TEXT, font=(FONT, 10))
    s.configure("TFrame", background=BG)
    s.configure("Card.TFrame", background=CARD)
    s.configure("TLabel", background=BG, foreground=TEXT)
    s.configure("Card.TLabel", background=CARD, foreground=TEXT)
    s.configure("Muted.TLabel", background=CARD, foreground=MUTED, font=(FONT, 9))
    s.configure("Title.TLabel", background=CARD, foreground=TEXT, font=(FONT, 12, "bold"))
    s.configure("Header.TLabel", background=ACCENT, foreground="white", font=(FONT, 14, "bold"))
    s.configure("Status.TLabel", background=CARD, foreground=MUTED, font=(FONT, 11))
    s.configure("JName.TLabel", background="#F9FAFB", foreground=MUTED, font=(FONT, 9, "bold"))
    s.configure("JVal.TLabel", background="#F9FAFB", foreground=TEXT, font=(MONO, 12, "bold"))
    s.configure("Big.TLabel", background=CARD, foreground=TEXT, font=(FONT, 20, "bold"))

    # Pestañas grandes para touch
    s.configure("TNotebook", background=BG, borderwidth=0, tabmargins=(0, 0, 0, 0))
    s.configure("TNotebook.Tab", padding=(22, 12), font=(FONT, 11, "bold"),
                background=OFF, foreground=MUTED)
    s.map("TNotebook.Tab",
          background=[("selected", CARD)],
          foreground=[("selected", ACCENT)])

    s.configure("TButton", padding=(10, 10), relief="flat", borderwidth=0,
                background=OFF, foreground=TEXT)
    s.map("TButton", background=[("active", OFF_H)])

    s.configure("Off.TButton", padding=(8, 18), background=OFF, foreground=TEXT, font=(FONT, 10, "bold"))
    s.map("Off.TButton", background=[("active", OFF_H)])
    s.configure("On.TButton", padding=(8, 18), background=GREEN, foreground="white", font=(FONT, 10, "bold"))
    s.map("On.TButton", background=[("active", GREEN_H)])

    s.configure("Accent.TButton", background=ACCENT, foreground="white", font=(FONT, 10, "bold"))
    s.map("Accent.TButton", background=[("active", ACCENT_H)])

    s.configure("Rec.TButton", padding=(20, 20), background=RED, foreground="white", font=(FONT, 13, "bold"))
    s.map("Rec.TButton", background=[("active", RED_H)])

    s.configure("Danger.TButton", padding=(12, 6), background=RED, foreground="white", font=(FONT, 10, "bold"))
    s.map("Danger.TButton", background=[("active", RED_H)])
    s.configure("Ghost.TButton", padding=(12, 6), background="#1E40AF", foreground="white", font=(FONT, 10, "bold"))
    s.map("Ghost.TButton", background=[("active", "#1E3A8A")])

    s.configure("Step.TButton", padding=(14, 12), font=(FONT, 12, "bold"))

    s.configure("TEntry", padding=8, fieldbackground="white", bordercolor=OFF)
    s.configure("TCheckbutton", background=CARD, foreground=TEXT, font=(FONT, 10))
    s.configure("TSeparator", background=OFF)
    return s


def run_gui(node, root):
    root.title("Yaren Robot Control")
    root.configure(bg=BG)
    root.geometry("800x480+0+0")
    root.attributes("-fullscreen", True)
    setup_style(root)

    # --- Pantalla completa: Esc / F11 alternan ---
    def toggle_fullscreen(event=None):
        root.attributes("-fullscreen", not root.attributes("-fullscreen"))

    root.bind("<Escape>", toggle_fullscreen)
    root.bind("<F11>", toggle_fullscreen)

    def on_close():
        node.execution_running = False
        if node.recording:
            node.stop_recording()
        root.destroy()

    root.protocol("WM_DELETE_WINDOW", on_close)

    # =================== CABECERA ===================
    header = tk.Frame(root, bg=ACCENT)
    header.pack(fill=tk.X)
    ttk.Label(header, text="  YAREN · Motor Control", style="Header.TLabel")\
        .pack(side=tk.LEFT, pady=8)
    ttk.Button(header, text="Salir", style="Ghost.TButton", command=on_close)\
        .pack(side=tk.RIGHT, padx=(6, 10), pady=6)
    ttk.Button(header, text="■ PARAR", style="Danger.TButton",
               command=lambda: setattr(node, 'execution_running', False))\
        .pack(side=tk.RIGHT, padx=6, pady=6)

    # =================== PESTAÑAS ===================
    nb = ttk.Notebook(root)
    nb.pack(fill=tk.BOTH, expand=True, padx=10, pady=(10, 10))

    tab_torque = ttk.Frame(nb, style="Card.TFrame", padding=16)
    tab_pos = ttk.Frame(nb, style="Card.TFrame", padding=16)
    tab_seq = ttk.Frame(nb, style="Card.TFrame", padding=16)
    tab_rec = ttk.Frame(nb, style="Card.TFrame", padding=16)
    nb.add(tab_torque, text="Torque")
    nb.add(tab_pos, text="Posiciones")
    nb.add(tab_seq, text="Secuencias")
    nb.add(tab_rec, text="Grabar")

    # ---------------------------------------------------------------
    # TAB 1: TORQUE
    # ---------------------------------------------------------------
    tab_torque.columnconfigure(0, weight=1)
    tab_torque.rowconfigure(1, weight=1)

    ttk.Label(tab_torque, text="Control de torque", style="Title.TLabel")\
        .grid(row=0, column=0, sticky="w", pady=(0, 10))

    grid_frame = ttk.Frame(tab_torque, style="Card.TFrame")
    grid_frame.grid(row=1, column=0, sticky="nsew")
    motor_buttons = {}

    def refresh_btn(m):
        motor_buttons[m].configure(style="On.TButton" if m.torque_state else "Off.TButton")

    def toggle_motor(m):
        state = not m.torque_state
        with node.port_lock:
            m.torque(1 if state else 0, 64)
        m.torque_state = state
        refresh_btn(m)

    def toggle_all():
        target = not any(m.torque_state for m in node.list_motors)
        with node.port_lock:
            for m in node.list_motors:
                m.torque(1 if target else 0, 64)
                m.torque_state = target
        for m in node.list_motors:
            refresh_btn(m)

    COLS = 3
    for i, m in enumerate(node.list_motors):
        btn = ttk.Button(grid_frame, text=m.name, style="Off.TButton",
                         command=lambda mot=m: toggle_motor(mot))
        btn.grid(row=i // COLS, column=i % COLS, padx=6, pady=6, sticky="nsew")
        motor_buttons[m] = btn
    for c in range(COLS):
        grid_frame.columnconfigure(c, weight=1, uniform="tq")
    for r in range((len(node.list_motors) + COLS - 1) // COLS):
        grid_frame.rowconfigure(r, weight=1)

    ttk.Button(tab_torque, text="TODOS  ON / OFF", style="Accent.TButton", command=toggle_all)\
        .grid(row=2, column=0, sticky="ew", pady=(12, 0))

    # ---------------------------------------------------------------
    # TAB 2: POSICIONES
    # ---------------------------------------------------------------
    tab_pos.columnconfigure(0, weight=1)

    top = ttk.Frame(tab_pos, style="Card.TFrame")
    top.grid(row=0, column=0, sticky="ew")
    top.columnconfigure(0, weight=1)
    ttk.Label(top, text="Posiciones actuales (rad)", style="Title.TLabel")\
        .grid(row=0, column=0, sticky="w")
    live_var = tk.BooleanVar(value=False)
    ttk.Checkbutton(top, text="En vivo", variable=live_var).grid(row=0, column=1, padx=10)
    
    cards = ttk.Frame(tab_pos, style="Card.TFrame")
    cards.grid(row=1, column=0, sticky="ew", pady=12)
    joint_vals = []
    for j in range(12):
        card = tk.Frame(cards, bg="#F9FAFB", highlightthickness=1, highlightbackground=OFF)
        card.grid(row=j // 6, column=j % 6, padx=4, pady=4, sticky="nsew")
        ttk.Label(card, text=f"J{j + 1}", style="JName.TLabel").pack(pady=(6, 0))
        v = ttk.Label(card, text="—", style="JVal.TLabel")
        v.pack(pady=(0, 6), padx=6)
        joint_vals.append(v)
    for c in range(6):
        cards.columnconfigure(c, weight=1, uniform="jc")

    set_entry = ttk.Entry(tab_pos, font=(MONO, 9))

    def refresh_positions():
        pos = node.get_positions()
        for lbl, val in zip(joint_vals, pos):
            lbl.configure(text=f"{val:.3f}")
        return pos

    def copy_to_entry():
        pos = refresh_positions()
        set_entry.delete(0, tk.END)
        set_entry.insert(0, str(pos))

    btn_row = ttk.Frame(tab_pos, style="Card.TFrame")
    btn_row.grid(row=2, column=0, sticky="ew")
    btn_row.columnconfigure((0, 1), weight=1, uniform="pb")
    ttk.Button(btn_row, text="Leer posiciones", command=refresh_positions)\
        .grid(row=0, column=0, sticky="ew", padx=(0, 6))
    ttk.Button(btn_row, text="Copiar a envío", command=copy_to_entry)\
        .grid(row=0, column=1, sticky="ew", padx=(6, 0))

    ttk.Separator(tab_pos, orient="horizontal").grid(row=3, column=0, sticky="ew", pady=12)

    ttk.Label(tab_pos, text="Enviar posiciones [J1 … J12] (rad)", style="Title.TLabel")\
        .grid(row=4, column=0, sticky="w", pady=(0, 6))
    send_row = ttk.Frame(tab_pos, style="Card.TFrame")
    send_row.grid(row=5, column=0, sticky="ew")
    send_row.columnconfigure(0, weight=1)
    set_entry.grid(in_=send_row, row=0, column=0, sticky="ew", padx=(0, 8))

    def do_set():
        try:
            node.set_positions(ast.literal_eval(set_entry.get()))
        except Exception as e:
            messagebox.showerror("Error", f"Lista inválida: {e}")

    ttk.Button(send_row, text="Enviar", style="Accent.TButton", command=do_set)\
        .grid(row=0, column=1)

    def live_loop():
        if live_var.get() and nb.index(nb.select()) == 1:
            refresh_positions()
        root.after(1000, live_loop)

    live_loop()

    # ---------------------------------------------------------------
    # TAB 3: SECUENCIAS
    # ---------------------------------------------------------------
    tab_seq.columnconfigure(0, weight=1)
    tab_seq.rowconfigure(1, weight=1)

    ttk.Label(tab_seq, text="Secuencia  ·  ([j1…j12], segundos)  o  [j1…j12]",
              style="Muted.TLabel").grid(row=0, column=0, sticky="w", pady=(0, 6))

    seq_text = scrolledtext.ScrolledText(tab_seq, font=(MONO, 9), bg="#FAFAFA", fg=TEXT,
                                         relief="flat", highlightthickness=1,
                                         highlightbackground=OFF, highlightcolor=ACCENT,
                                         insertbackground=TEXT, wrap=tk.NONE, height=6)
    seq_text.grid(row=1, column=0, sticky="nsew")

    btns = ttk.Frame(tab_seq, style="Card.TFrame")
    btns.grid(row=2, column=0, sticky="ew", pady=(12, 0))
    btns.columnconfigure(tuple(range(5)), weight=1, uniform="sb")

    def sleep_interruptible(t):
        end = time.time() + t
        while node.execution_running and time.time() < end:
            time.sleep(0.05)

    def run_seq():
        if node.execution_running:
            return
        node.execution_running = True
        lines = seq_text.get("1.0", tk.END).strip().split('\n')

        def task():
            for line in lines:
                if not node.execution_running:
                    break
                try:
                    clean = line.strip()
                    if '.' in clean:
                        parts = clean.split('.', 1)
                        if parts[0].isdigit():
                            clean = parts[1].strip()
                    if not clean:
                        continue

                    data = ast.literal_eval(clean)
                    if isinstance(data, tuple) and len(data) == 2:
                        positions, t = data
                    else:
                        positions, t = data, 1.0

                    node.set_positions(positions)
                    sleep_interruptible(t)

                except Exception as e:
                    node.get_logger().error(f"Error parseando línea: {e}")
                    continue
            node.execution_running = False

        threading.Thread(target=task, daemon=True).start()

    def load_file():
        path = filedialog.askopenfilename()
        if path:
            with open(path, 'r') as f:
                seq_text.delete("1.0", tk.END)
                seq_text.insert(tk.END, f.read())

    def save_file():
        path = filedialog.asksaveasfilename(defaultextension=".txt",
                                            filetypes=[("Texto", "*.txt"), ("Todos", "*.*")])
        if path:
            with open(path, 'w') as f:
                f.write(seq_text.get("1.0", tk.END).strip() + "\n")

    ttk.Button(btns, text="▶ Execute", style="Accent.TButton", command=run_seq)\
        .grid(row=0, column=0, sticky="ew", padx=3)
    ttk.Button(btns, text="■ Stop", command=lambda: setattr(node, 'execution_running', False))\
        .grid(row=0, column=1, sticky="ew", padx=3)
    ttk.Button(btns, text="Cargar", command=load_file).grid(row=0, column=2, sticky="ew", padx=3)
    ttk.Button(btns, text="Guardar", command=save_file).grid(row=0, column=3, sticky="ew", padx=3)
    ttk.Button(btns, text="Limpiar", command=lambda: seq_text.delete("1.0", tk.END))\
        .grid(row=0, column=4, sticky="ew", padx=3)

    # ---------------------------------------------------------------
    # TAB 4: GRABAR RUTINA
    # ---------------------------------------------------------------
    tab_rec.columnconfigure(0, weight=1)
    tab_rec.rowconfigure(0, weight=1)
    tab_rec.rowconfigure(4, weight=1)

    center = ttk.Frame(tab_rec, style="Card.TFrame")
    center.grid(row=1, column=0)

    ttk.Label(center, text="Grabar rutina", style="Title.TLabel").grid(row=0, column=0, columnspan=5, pady=(0, 4))
    ttk.Label(center, text="Guarda J5–J12 cada N segundos (J1–J4 fijos)",
              style="Muted.TLabel").grid(row=1, column=0, columnspan=5, pady=(0, 16))

    interval_var = tk.IntVar(value=10)

    def step(delta):
        interval_var.set(max(1, min(600, interval_var.get() + delta)))

    ttk.Button(center, text="−5", style="Step.TButton", width=4, command=lambda: step(-5)).grid(row=2, column=0, padx=3)
    ttk.Button(center, text="−1", style="Step.TButton", width=4, command=lambda: step(-1)).grid(row=2, column=1, padx=3)
    ttk.Label(center, textvariable=interval_var, style="Big.TLabel", width=4, anchor="center")\
        .grid(row=2, column=2, padx=6)
    ttk.Button(center, text="+1", style="Step.TButton", width=4, command=lambda: step(1)).grid(row=2, column=3, padx=3)
    ttk.Button(center, text="+5", style="Step.TButton", width=4, command=lambda: step(5)).grid(row=2, column=4, padx=3)
    ttk.Label(center, text="segundos entre poses", style="Muted.TLabel")\
        .grid(row=3, column=0, columnspan=5, pady=(2, 18))

    rec_btn = ttk.Button(center, text="●  Grabar rutina", style="Rec.TButton")
    rec_btn.grid(row=4, column=0, columnspan=5, sticky="ew")
    rec_status = ttk.Label(center, text="Inactivo", style="Status.TLabel")
    rec_status.grid(row=5, column=0, columnspan=5, pady=(14, 0))

    def toggle_record():
        if not node.recording:
            node.start_recording(interval_var.get())
            rec_btn.configure(text="■  Detener grabación")
        else:
            lines = node.stop_recording()
            rec_btn.configure(text="●  Grabar rutina")
            seq_text.delete("1.0", tk.END)
            seq_text.insert(tk.END, "\n".join(lines))
            rec_status.configure(text=f"Rutina generada: {len(lines)} poses")
            nb.select(tab_seq)   # salta a Secuencias para ver el resultado

    rec_btn.configure(command=toggle_record)

    def poll_rec_status():
        if node.recording:
            rec_status.configure(text=f"● Grabando…  {len(node._rec_samples)} poses capturadas")
        root.after(500, poll_rec_status)

    poll_rec_status()

    root.mainloop()


def main():
    rclpy.init()
    node = MotorTorqueControlNode()

    # ROS en hilo secundario; Tkinter en el hilo principal
    threading.Thread(target=rclpy.spin, args=(node,), daemon=True).start()

    try:
        root = tk.Tk()
        run_gui(node, root)
    except KeyboardInterrupt:
        pass
    finally:
        node.portHandler.closePort()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
